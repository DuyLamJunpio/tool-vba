<Window x:Class="ToolVba.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Công cụ VBA cho Excel — VBA source fix 5"
        Width="1200" Height="850" MinWidth="820" MinHeight="700"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
  <Window.Resources>
    <Style x:Key="BrowseButton" TargetType="Button">
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ModeTab" TargetType="TabItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="ModeBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="17,13">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,2,10,0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PathValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Margin="34,28,34,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,25">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="WORKBOOK  /  VBA" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" />
        <TextBlock Text="Đóng gói VBA cho Excel" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,2" />
        <TextBlock Text="Chọn cách thêm mã, kiểm tra thông tin và lưu ra một workbook mới."
                   Foreground="{StaticResource Muted}" FontSize="14" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="13,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="XỬ LÝ CỤC BỘ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" />
        </StackPanel>
      </Border>
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,18">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <UniformGrid IsItemsHost="True" Rows="1" Columns="2" KeyboardNavigation.TabIndex="1" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabControl.ItemContainerStyle>
        <Style TargetType="TabItem" BasedOn="{StaticResource ModeTab}" />
      </TabControl.ItemContainerStyle>
      <TabItem>
        <TabItem.Header>
          <StackPanel>
            <TextBlock Text="Thêm module .bas" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Nhận .xlsx/.xlsm, thêm một module mới" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
        </TabItem.Header>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel>
            <TextBlock Text="Dùng vbaProject.bin" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Đóng gói toàn bộ project vào workbook" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
        </TabItem.Header>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
            <TextBlock Text="01" Style="{StaticResource StepNumber}" />
            <StackPanel>
              <TextBlock Text="Workbook nguồn" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="File ban đầu sẽ được giữ nguyên." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10" MinHeight="42">
              <TextBlock Text="{Binding WorkbookDisplay}" Style="{StaticResource PathValue}" />
            </Border>
            <Button Grid.Column="1" Content="Chọn workbook" Command="{Binding BrowseWorkbookCommand}" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" />
          </Grid>

          <Separator Background="{StaticResource Line}" Height="1" />

          <StackPanel Orientation="Horizontal" Margin="0,17,0,12">
            <TextBlock Text="02" Style="{StaticResource StepNumber}" />
            <StackPanel>
              <TextBlock Text="Tệp VBA" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Chọn đúng loại tệp theo cách đóng gói ở phía trên." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <TabControl SelectedIndex="{Binding SelectedModeIndex, Mode=OneWay}" Background="Transparent" BorderThickness="0">
            <TabControl.Template>
              <ControlTemplate TargetType="TabControl">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
              </ControlTemplate>
            </TabControl.Template>
            <TabItem>
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10" MinHeight="42">
                    <TextBlock Text="{Binding ModuleDisplay}" Style="{StaticResource PathValue}" />
                  </Border>
                  <Button Grid.Column="1" Content="Chọn module .bas" Command="{Binding BrowseModuleCommand}" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10" MinHeight="42">
                    <TextBlock Text="{Binding ManifestDisplay}" Style="{StaticResource PathValue}" />
                  </Border>
                  <Button Grid.Column="1" Content="Chọn manifest .json" Command="{Binding BrowseManifestCommand}" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" />
                </Grid>
              </StackPanel>
            </TabItem>
            <TabItem>
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10" MinHeight="42">
                    <TextBlock Text="{Binding VbaDisplay}" Style="{StaticResource PathValue}" />
                  </Border>
                  <Button Grid.Column="1" Content="Chọn tệp .bin" Command="{Binding BrowseBinaryCommand}" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" />
                </Grid>
                <CheckBox IsChecked="{Binding ConfirmVbaReplacement, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" Margin="1,2,0,0" Foreground="{StaticResource Ink}">
                  <TextBlock Text="Xác nhận thay toàn bộ VBA project hiện có trong workbook" TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
            </TabItem>
          </TabControl>

          <Separator Background="{StaticResource Line}" Height="1" Margin="0,19,0,0" />

          <StackPanel Orientation="Horizontal" Margin="0,17,0,11">
            <TextBlock Text="03" Style="{StaticResource StepNumber}" />
            <StackPanel>
              <TextBlock Text="Nơi lưu kết quả" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Tạo file .xlsm riêng, không ghi đè workbook nguồn." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10" MinHeight="42">
              <TextBlock Text="{Binding OutputDisplay}" Style="{StaticResource PathValue}" />
            </Border>
            <Button Grid.Column="1" Content="Chọn nơi lưu" Command="{Binding BrowseOutputCommand}" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" />
          </Grid>

          <Border Background="{StaticResource Notice}" CornerRadius="5" Padding="13,11" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NoticeInk}" FontSize="12.5" LineHeight="18">
              <Run FontWeight="SemiBold" Text="Lưu ý an toàn  " />
              <Run Text="Macro không được chạy trong lúc đóng gói. Chế độ .bas làm việc trên bản tạm; chế độ .bin thay toàn bộ project trong file kết quả." />
            </TextBlock>
          </Border>

          <Button Content="Kiểm tra và tạo workbook" Command="{Binding CreateCommand}" IsEnabled="{Binding IsIdle}"
                  HorizontalAlignment="Stretch" Background="{StaticResource Accent}" Foreground="White"
                  BorderThickness="0" Padding="16,13" FontSize="15" FontWeight="SemiBold" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="3" CornerRadius="7" Padding="16,14" Margin="0,14,0,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="White" />
          <Setter Property="BorderBrush" Value="{StaticResource Line}" />
          <Setter Property="BorderThickness" Value="1" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
              <Setter Property="Background" Value="#FFF0ED" />
              <Setter Property="BorderBrush" Value="#B6382E" />
              <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <ProgressBar IsIndeterminate="{Binding IsWorking}" Value="{Binding ProgressPercent, Mode=OneWay}"
                       Height="3" Margin="0,0,0,8" Background="{StaticResource SurfaceSoft}" Foreground="{StaticResource Accent}" />
          <TextBlock Text="CẦN KIỂM TRA" Foreground="#9F2E25" FontSize="12" FontWeight="Bold" Margin="0,0,0,4">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MinHeight="20">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="13" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="#84251D" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,3,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NoticeInk}" FontSize="12" Margin="0,2" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Button Grid.Column="1" Content="Mở thư mục kết quả" Command="{Binding OpenOutputFolderCommand}"
                IsEnabled="{Binding CanOpenOutputFolder}" VerticalAlignment="Center" Margin="14,0,0,0"
                Padding="12,9" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" />
      </Grid>
    </Border>
  </Grid>
</Window>
