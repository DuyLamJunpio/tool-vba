<Window x:Class="ToolVba.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="980" Height="800" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
  <Window.Resources>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline" FontSize="12.5" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Banner" TargetType="Border">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="IsEnabled" Value="{Binding IsIdle}" />
    </Style>
  </Window.Resources>

  <Grid Margin="32,24,32,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Đóng gói bản quyền cho sản phẩm Excel" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Thả file sản phẩm, nhập sản phẩm trên cửa hàng rồi bấm Tạo. App gắn module bản quyền, thêm sheet hướng dẫn và ẩn các sheet khác; file gốc không bị sửa."
                   Foreground="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Column="1" CornerRadius="14" Padding="12,7" VerticalAlignment="Top" Margin="16,4,0,0" MaxWidth="360">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Package.HasProblem}" Value="True">
                <Setter Property="Background" Value="{StaticResource Notice}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Accent}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Package.HasProblem}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource NoticeInk}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding Package.Text}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Banners -->
    <StackPanel Grid.Row="1">
      <Border Style="{StaticResource Banner}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
              Visibility="{Binding Update.IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Update.Title}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding Update.Detail}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
            <ProgressBar Value="{Binding Update.ProgressPercent, Mode=OneWay}" Height="3" Margin="0,8,0,0" Foreground="{StaticResource Accent}"
                         Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Cập nhật ngay" Command="{Binding Update.UpdateNowCommand}" VerticalAlignment="Center" Margin="14,0,0,0"
                  Style="{StaticResource PrimaryButton}" Padding="16,9" FontSize="14"
                  Visibility="{Binding Update.CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Banner}" Background="{StaticResource Notice}"
              Visibility="{Binding Trust.IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Trust.Message}" Foreground="{StaticResource NoticeInk}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Bật giúp tôi" Command="{Binding Trust.EnableCommand}" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0"
                  Visibility="{Binding Trust.CanEnable, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Main card -->
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Empty state: drop zone -->
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasFile}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Rectangle Stroke="{StaticResource Line}" StrokeThickness="2" StrokeDashArray="5 4" RadiusX="9" RadiusY="9" Fill="{StaticResource SurfaceSoft}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="⬇" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
            <TextBlock Text="Kéo thả file Excel sản phẩm (.xlsx / .xlsm) vào đây" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
            <TextBlock Text="Mỗi lần một file cho một sản phẩm" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,14" />
            <Button Content="Chọn file…" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- The chosen file -->
        <Border VerticalAlignment="Top" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14,12"
                Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
          <Grid DataContext="{Binding Workbook}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{Binding SizeText, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" />
              </TextBlock>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                <Run Text="→" />
                <Run Text="{Binding OutputName, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerInk}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="10" Padding="10,3" VerticalAlignment="Top" Margin="12,0,8,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource SurfaceSoft}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                      <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Button Grid.Column="2" Content="Đổi file…" Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Padding="10,4" />
          </Grid>
        </Border>

        <!-- Store product -->
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
          <TextBlock Text="Sản phẩm trên cửa hàng" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Dán mã đóng gói (Admin web › Sản phẩm › Phiên bản › Sao chép mã đóng gói), hoặc nhập tay mã sản phẩm và phiên bản."
                     Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,10" />
          <TextBlock Text="Mã đóng gói" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Product.PackagingCodeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                   FontFamily="Consolas" ToolTip='Ví dụ: {"productKey":"test-01","version":"1.0.0"}' />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Mã sản phẩm (productKey)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Product.ProductKeyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Phiên bản (x.y.z)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Product.VersionText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Product.Error}" Foreground="{StaticResource DangerInk}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Product.Error}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <!-- Output folder -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,12">
          <TextBlock Text="Nơi lưu: " Foreground="{StaticResource Muted}" FontSize="12.5" />
          <TextBlock Text="{Binding OutputFolderText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="460" />
          <Button Content="Đổi nơi lưu" Command="{Binding ChangeOutputFolderCommand}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" />
          <Button Content="Lưu cạnh file gốc" Command="{Binding ResetOutputFolderCommand}" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                  Visibility="{Binding HasCustomOutputFolder, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Button Grid.Row="3" Content="Tạo file có bản quyền" Command="{Binding CreateCommand}"
                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="16,14" FontSize="16" />
      </Grid>
    </Border>

    <!-- Status -->
    <Border Grid.Row="3" CornerRadius="7" Padding="16,12" Margin="0,12,0,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="White" />
          <Setter Property="BorderBrush" Value="{StaticResource Line}" />
          <Setter Property="BorderThickness" Value="1" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
              <Setter Property="Background" Value="{StaticResource DangerSoft}" />
              <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
              <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="3" Margin="0,0,0,8"
                       Background="{StaticResource SurfaceSoft}" Foreground="{StaticResource Accent}"
                       Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerInk}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,3,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource NoticeInk}" FontSize="12" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                    Visibility="{Binding CanOpenOutput, Converter={StaticResource BoolToVisibility}}">
          <Button Content="Mở file" Command="{Binding OpenOutputCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
          <Button Content="Mở thư mục" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer -->
    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding WindowTitle}" Foreground="{StaticResource Muted}" FontSize="11.5" />
      <TextBlock Text="Xử lý cục bộ bằng Excel trên máy này; macro không được chạy trong lúc dán code." Foreground="{StaticResource Muted}" FontSize="11.5" />
    </DockPanel>

    <!-- Drag overlay -->
    <Border x:Name="DropOverlay" Grid.RowSpan="5" Background="#CCEDF3EC" BorderBrush="{StaticResource Accent}" BorderThickness="3"
            CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock Text="Thả file Excel sản phẩm vào đây" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
